---
interface Props {
  embedUrl: string;
  title: string;
  episodeNumber: number;
  class?: string;
}

const { embedUrl, title, episodeNumber, class: className = '' } = Astro.props;
---

<div class:list={['max-w-md overflow-hidden rounded-lg border border-line dark:border-line-dark', className]}>
  <iframe
    src={embedUrl}
    title={`Play ${title}, Episode ${episodeNumber}`}
    width="100%"
    height="152"
    style="display: block; border: 0;"
    allow="encrypted-media"
    loading="lazy"
  />
</div>
