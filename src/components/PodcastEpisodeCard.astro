---
import Icon from './Icon.astro';
import { parseEpisodeDate, type Episode } from '../data/podcast';

interface Props {
  episode: Episode;
}

const { episode } = Astro.props;

const formattedDate = parseEpisodeDate(episode.date).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<a
  href={episode.href}
  class="group -mx-3 flex flex-col gap-2 rounded-lg border-b border-line px-3 py-7 transition-colors first:pt-0 last:border-b-0 hover:bg-surface sm:flex-row sm:items-start sm:gap-8 dark:border-line-dark dark:hover:bg-surface-dark"
>
  <p class="tabular-nums shrink-0 text-[13px] text-faint sm:w-24 sm:pt-0.5 dark:text-subtle-dark">{formattedDate}</p>

  <div class="min-w-0 flex-1">
    <p class="tabular-nums text-[12px] text-faint dark:text-subtle-dark">
      Episode {episode.number} · {episode.duration}
      {episode.guest && <> · with {episode.guest}</>}
    </p>
    <h3 class="link-underline text-balance mt-1 inline-block text-[17px] font-medium text-ink transition-colors group-hover:text-accent dark:text-ink-dark dark:group-hover:text-accent-dark">
      {episode.title}
    </h3>
    <p class="measure mt-1 text-[14px] leading-relaxed text-subtle dark:text-subtle-dark">
      {episode.summary}
    </p>
  </div>

  <span
    class="inline-flex shrink-0 items-center gap-1.5 border-b border-transparent pb-0.5 text-[13px] font-medium text-subtle transition-colors duration-fast group-hover:border-accent group-hover:text-accent sm:pt-0.5 dark:text-subtle-dark dark:group-hover:border-accent-dark dark:group-hover:text-accent-dark"
  >
    Play
    <Icon
      name="play"
      class="h-3 w-3 transition-transform duration-fast ease-standard group-hover:translate-x-0.5"
    />
  </span>
</a>
