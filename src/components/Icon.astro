---
export type IconName = 'linkedin' | 'email' | 'arrow-right' | 'chevron-down' | 'play' | 'external' | 'close';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-4 w-4' } = Astro.props;
---

{
  name === 'linkedin' && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.94v5.67H9.33V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.28 2.37 4.28 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z" />
    </svg>
  )
}
{
  name === 'email' && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className} aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2.5" />
      <path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'arrow-right' && (
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
      <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'chevron-down' && (
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
      <path d="M4 6.2 8 10l4-3.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'play' && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86A1 1 0 0 0 8 5.14z" />
    </svg>
  )
}
{
  name === 'external' && (
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" class={className} aria-hidden="true">
      <path d="M6 3H3v10h10v-3M9 3h4v4M13 3 7 9" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
