---
const navItems = [
  { label: 'Podcast', href: '/podcast/' },
  { label: 'Writing', href: '/writing/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Contact', href: '/#connect' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href.includes('#')) return false;
  return currentPath.startsWith(href);
}
---

<header
  class="sticky top-0 z-50 border-b border-line/70 bg-paper/80 backdrop-blur-xl dark:border-line-dark/70 dark:bg-paper-dark/80"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6">
    <a
      href="/"
      class="text-[13px] font-semibold tracking-tight text-ink transition-opacity hover:opacity-70 dark:text-ink-dark"
    >
      Hayden Garrick
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'text-[13px] transition-colors duration-200',
                  isActive(item.href)
                    ? 'text-ink dark:text-ink-dark'
                    : 'text-subtle hover:text-ink dark:text-subtle-dark dark:hover:text-ink-dark',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="group relative md:hidden">
      <summary
        class="flex h-11 w-11 -mr-2.5 cursor-pointer list-none items-center justify-center rounded-full text-ink transition-colors hover:bg-surface [&::-webkit-details-marker]:hidden dark:text-ink-dark dark:hover:bg-surface-dark"
        aria-label="Open menu"
      >
        <svg
          class="h-4 w-4 group-open:hidden"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          aria-hidden="true"
        >
          <path d="M1 4h14M1 8h14M1 12h14" stroke-linecap="round" />
        </svg>
        <svg
          class="hidden h-4 w-4 group-open:block"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          aria-hidden="true"
        >
          <path d="M2 2l12 12M14 2L2 14" stroke-linecap="round" />
        </svg>
      </summary>
      <nav
        aria-label="Primary"
        class="absolute top-12 right-0 w-52 rounded-2xl border border-line bg-paper/95 py-2 shadow-lg backdrop-blur-xl dark:border-line-dark dark:bg-surface-dark/95"
      >
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'flex items-center px-4 py-3 text-[14px] transition-colors',
                    isActive(item.href)
                      ? 'text-ink dark:text-ink-dark'
                      : 'text-subtle hover:text-ink dark:text-subtle-dark dark:hover:text-ink-dark',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  function initMobileNav() {
    document.querySelectorAll<HTMLDetailsElement>('header details').forEach((menu) => {
      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menu.open = false;
        });
      });
    });
  }

  initMobileNav();
  document.addEventListener('astro:page-load', initMobileNav);
</script>
