---
import SectionRow from './SectionRow.astro';
import Icon from './Icon.astro';

interface Props {
  id?: string;
  title: string;
  description: string;
  href?: string;
  ctaLabel?: string;
  meta?: string;
  class?: string;
}

const { id, title, description, href, ctaLabel = 'Learn more', meta, class: className = '' } = Astro.props;
const isExternal = href?.startsWith('http');
---

<SectionRow id={id} class={className}>
  <h2 class="text-subheading font-semibold text-ink dark:text-ink-dark">{title}</h2>
  <p class="measure mt-5 text-[1.0625rem] leading-relaxed text-subtle dark:text-subtle-dark">
    {description}
  </p>

  <slot name="media" />

  <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2">
    <slot name="cta">
      <a
        href={href}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noreferrer noopener' : undefined}
        aria-label={isExternal ? `${ctaLabel} (opens in a new tab)` : undefined}
        class="group -my-2.5 inline-flex items-center gap-1.5 py-2.5 text-[15px] font-medium text-ink transition-colors duration-fast hover:text-accent dark:text-ink-dark dark:hover:text-accent-dark"
      >
        <span class="border-b border-ink/30 pb-0.5 transition-colors duration-fast group-hover:border-accent dark:border-ink-dark/30 dark:group-hover:border-accent-dark">
          {ctaLabel}
        </span>
        <Icon
          name="arrow-right"
          class="h-3.5 w-3.5 transition-transform duration-fast ease-standard group-hover:translate-x-1"
        />
      </a>
    </slot>
    {meta && <p class="tabular-nums text-[12px] text-faint dark:text-subtle-dark">{meta}</p>}
  </div>
</SectionRow>
