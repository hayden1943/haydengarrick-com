---
import SectionRow from './SectionRow.astro';
import Icon from './Icon.astro';

interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  ctaLabel?: string;
  meta?: string;
  class?: string;
}

const { id, eyebrow, title, description, href, ctaLabel = 'Learn more', meta, class: className = '' } = Astro.props;
---

<SectionRow id={id} eyebrow={eyebrow} class={className}>
  <h2 class="text-subheading font-semibold text-ink dark:text-ink-dark">{title}</h2>
  <p class="mt-3 text-[1.0625rem] leading-relaxed text-subtle dark:text-subtle-dark">
    {description}
  </p>

  <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
    <a
      href={href}
      class="group -my-2.5 inline-flex items-center gap-1.5 py-2.5 text-[15px] font-medium text-ink transition-colors duration-fast hover:text-accent dark:text-ink-dark dark:hover:text-accent-dark"
    >
      <span class="border-b border-ink/30 pb-0.5 transition-colors duration-fast group-hover:border-accent dark:border-ink-dark/30 dark:group-hover:border-accent-dark">
        {ctaLabel}
      </span>
      <Icon
        name="arrow-right"
        class="h-3.5 w-3.5 transition-transform duration-fast ease-standard group-hover:translate-x-1"
      />
    </a>
    {meta && <p class="tabular-nums text-[13px] text-faint dark:text-subtle-dark">{meta}</p>}
  </div>
</SectionRow>
