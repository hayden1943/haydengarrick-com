---
interface Props {
  id?: string;
  class?: string;
}

const { id, class: className = '' } = Astro.props;
---

<div id={id} class:list={['scroll-mt-24', className]}>
  <div class="rule-reveal reveal h-px max-w-3xl bg-line dark:bg-line-dark"></div>

  <div class="stagger reveal max-w-3xl py-7 sm:py-8">
    <slot />
  </div>
</div>
