---
import Icon from './Icon.astro';
import type { PodcastPlatform } from '../data/podcast';

interface Props {
  platforms: PodcastPlatform[];
  label?: string;
  id?: string;
  class?: string;
}

const { platforms, label = 'Listen', id = 'listen', class: className = '' } = Astro.props;
const panelId = `${id}-platforms`;
const triggerId = `${id}-trigger`;
---

<div class:list={['popover relative inline-block', className]} data-popover>
  <button
    type="button"
    id={triggerId}
    class="popover-trigger group -my-2.5 inline-flex items-center gap-1.5 py-2.5 text-[15px] font-medium text-ink transition-colors duration-fast hover:text-accent dark:text-ink-dark dark:hover:text-accent-dark"
    aria-expanded="false"
    aria-controls={panelId}
  >
    <span class="border-b border-ink/30 pb-0.5 transition-colors duration-fast group-hover:border-accent dark:border-ink-dark/30 dark:group-hover:border-accent-dark">
      {label}
    </span>
    <Icon
      name="chevron-down"
      class="popover-chevron h-3.5 w-3.5 transition-transform duration-fast ease-standard"
    />
  </button>

  <div
    id={panelId}
    class="popover-panel absolute top-full left-0 z-[60] mt-2 w-60 rounded-lg border border-line bg-paper py-1.5 shadow-[0_10px_28px_-10px_rgba(0,0,0,0.18)] dark:border-line-dark dark:bg-surface-dark dark:shadow-[0_10px_28px_-10px_rgba(0,0,0,0.5)]"
    role="group"
    aria-labelledby={triggerId}
    hidden
  >
    <p class="px-3 pt-1 pb-1.5 text-[13px] font-medium tracking-[0.06em] text-faint uppercase dark:text-subtle-dark">
      Listen on
    </p>
    <ul>
      {
        platforms.map((platform) => (
          <li>
            <a
              href={platform.href}
              target="_blank"
              rel="noreferrer noopener"
              class="flex items-center gap-2.5 px-3 py-2.5 text-[14px] text-ink transition-colors duration-fast hover:bg-surface dark:text-ink-dark dark:hover:bg-paper-dark"
            >
              <span class="flex-1">{platform.name}</span>
              <Icon
                name="external"
                class="h-3 w-3 shrink-0 text-faint dark:text-subtle-dark"
                aria-hidden="true"
              />
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .popover-panel {
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .popover-panel.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .popover-trigger[aria-expanded='true'] .popover-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  const CLOSE_CLASS = 'is-open';
  let globalListenersAttached = false;

  function initPodcastPopovers() {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hideDelay = reducedMotion ? 0 : 180;

    function getParts(root: HTMLElement) {
      const trigger = root.querySelector<HTMLButtonElement>('.popover-trigger');
      const panel = root.querySelector<HTMLElement>('.popover-panel');
      return { trigger, panel };
    }

    function isOpen(root: HTMLElement) {
      const { trigger } = getParts(root);
      return trigger?.getAttribute('aria-expanded') === 'true';
    }

    function positionPanel(root: HTMLElement) {
      const { panel } = getParts(root);
      if (!panel) return;
      panel.style.left = '0px';
      panel.style.right = 'auto';
      const rect = panel.getBoundingClientRect();
      if (rect.right > window.innerWidth - 8) {
        panel.style.left = 'auto';
        panel.style.right = '0px';
      }
      if (rect.bottom > window.innerHeight - 8 && rect.top - rect.height > 8) {
        panel.style.top = 'auto';
        panel.style.bottom = 'calc(100% + 0.5rem)';
      } else {
        panel.style.top = '100%';
        panel.style.bottom = 'auto';
      }
    }

    function openPopover(root: HTMLElement) {
      document.querySelectorAll<HTMLElement>('[data-popover]').forEach((other) => {
        if (other !== root) closePopover(other);
      });
      const { trigger, panel } = getParts(root);
      if (!trigger || !panel) return;
      panel.hidden = false;
      // Force a reflow so the opacity/transform transition runs from its initial
      // state instead of jumping straight to open.
      void panel.offsetHeight;
      panel.classList.add(CLOSE_CLASS);
      trigger.setAttribute('aria-expanded', 'true');
      positionPanel(root);
    }

    function closePopover(root: HTMLElement, opts: { focusTrigger?: boolean } = {}) {
      const { trigger, panel } = getParts(root);
      if (!trigger || !panel) return;
      if (trigger.getAttribute('aria-expanded') !== 'true') return;
      panel.classList.remove(CLOSE_CLASS);
      trigger.setAttribute('aria-expanded', 'false');
      window.setTimeout(() => {
        if (!panel.classList.contains(CLOSE_CLASS)) panel.hidden = true;
      }, hideDelay);
      if (opts.focusTrigger) trigger.focus();
    }

    document.querySelectorAll<HTMLElement>('[data-popover]').forEach((root) => {
      const { trigger, panel } = getParts(root);
      if (!trigger || !panel || trigger.dataset.popoverInit) return;
      trigger.dataset.popoverInit = 'true';

      trigger.addEventListener('click', () => {
        if (isOpen(root)) closePopover(root);
        else openPopover(root);
      });

      panel.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) closePopover(root);
      });

      // Keep the popover open while focus moves between the trigger and panel;
      // only close once focus lands somewhere outside both.
      root.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (!next || !root.contains(next)) closePopover(root);
      });
    });

    if (!globalListenersAttached) {
      globalListenersAttached = true;

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Node)) return;
        document.querySelectorAll<HTMLElement>('[data-popover]').forEach((root) => {
          if (!root.contains(event.target as Node)) closePopover(root);
        });
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        document.querySelectorAll<HTMLElement>('[data-popover]').forEach((root) => {
          if (isOpen(root)) closePopover(root, { focusTrigger: true });
        });
      });

      document.addEventListener('astro:before-swap', () => {
        document.querySelectorAll<HTMLElement>('[data-popover]').forEach((root) => closePopover(root));
      });
    }
  }

  initPodcastPopovers();
  document.addEventListener('astro:page-load', initPodcastPopovers);
</script>
