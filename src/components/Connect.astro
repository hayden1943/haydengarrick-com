---
import Icon from './Icon.astro';
import { socialLinks } from '../data/social';
---

<h2 class="text-subheading font-semibold text-ink dark:text-ink-dark">Connect</h2>
<p class="measure mt-4 text-[1.0625rem] leading-relaxed text-subtle dark:text-subtle-dark">
  For questions, collaborations, podcast inquiries, or anything worth discussing.
</p>

<ul class="mt-6 flex flex-col">
  {
    socialLinks.map((link) => {
      const isEmail = link.icon === 'email';
      const displayValue = isEmail ? link.href.replace('mailto:', '') : link.label;
      return (
        <li>
          <a
            href={link.href}
            target={isEmail ? undefined : '_blank'}
            rel={isEmail ? undefined : 'noreferrer noopener'}
            aria-label={isEmail ? undefined : `${link.label} (opens in a new tab)`}
            class="group -mx-3 flex items-center gap-2.5 rounded-lg px-3 py-3 text-[17px] font-medium text-ink transition-colors duration-fast hover:bg-surface hover:text-accent dark:text-ink-dark dark:hover:bg-surface-dark dark:hover:text-accent-dark"
          >
            <Icon name={link.icon} class="h-4 w-4 text-faint transition-colors duration-fast group-hover:text-accent dark:text-subtle-dark dark:group-hover:text-accent-dark" />
            <span class="border-b border-transparent group-hover:border-accent dark:group-hover:border-accent-dark">{displayValue}</span>
          </a>
        </li>
      );
    })
  }
</ul>
