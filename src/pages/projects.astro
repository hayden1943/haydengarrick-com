---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureSection from '../components/FeatureSection.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const featured = projects.filter((project) => project.featured);
const otherProjects = projects.filter((project) => !project.featured);
---

<BaseLayout
  title="Projects"
  description="Products built by Hayden Garrick, including After Office Hours and CarROI."
>
  <section class="px-6 pt-20 pb-10 sm:pt-28 sm:pb-12 lg:px-10">
    <div class="mx-auto max-w-6xl">
      <p class="text-[13px] font-medium tracking-[0.06em] text-subtle uppercase dark:text-subtle-dark">Projects</p>
      <h1 class="text-heading mt-2 max-w-2xl font-semibold text-ink dark:text-ink-dark">Things I've built.</h1>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-6 pb-4 lg:px-10">
    {
      featured.map((project) => (
        <FeatureSection
          eyebrow={project.tags[0]}
          title={project.name}
          description={project.description}
          href={project.href}
          ctaLabel={`Explore ${project.name}`}
        />
      ))
    }
  </div>

  {
    otherProjects.length > 0 && (
      <section class="border-t border-line px-6 py-16 sm:py-20 lg:px-10 dark:border-line-dark">
        <div class="mx-auto max-w-6xl">
          <h2 class="text-[13px] font-medium tracking-[0.06em] text-subtle uppercase dark:text-subtle-dark">
            More projects
          </h2>
          <div class="mt-6 max-w-3xl">
            {otherProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
