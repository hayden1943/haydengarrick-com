---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureSection from '../components/FeatureSection.astro';
import SectionRow from '../components/SectionRow.astro';
import ArticleRow from '../components/ArticleRow.astro';
import Connect from '../components/Connect.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import PodcastPlatformPopover from '../components/PodcastPlatformPopover.astro';
import SpotifyEmbedPlayer from '../components/SpotifyEmbedPlayer.astro';
import { projects } from '../data/projects';
import { latestEpisode, getEpisodePlatforms, parseEpisodeDate } from '../data/podcast';
import { socialLinks, linkedInNewsletterUrl } from '../data/social';
import { legacyBlog } from '../data/legacy';

const [afterOfficeHours, carRoi] = projects;

const articles = (await getCollection('writing'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const latestEpisodeDate = parseEpisodeDate(latestEpisode.date).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
});

const latestEpisodePlatforms = getEpisodePlatforms(latestEpisode);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Hayden Garrick',
  url: Astro.site?.toString(),
  sameAs: socialLinks.filter((link) => link.icon !== 'email').map((link) => link.href),
};
---

<BaseLayout title="Hayden Garrick">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

  <Hero />

  <div class="content-inset mx-auto max-w-7xl">
    <FeatureSection
      id="podcast"
      title={afterOfficeHours.name}
      description={afterOfficeHours.tagline}
      meta={`Episode ${latestEpisode.number} · ${latestEpisodeDate}`}
    >
      {
        latestEpisode.spotifyEmbedUrl && (
          <SpotifyEmbedPlayer
            slot="media"
            class="mt-6"
            embedUrl={latestEpisode.spotifyEmbedUrl}
            title={latestEpisode.title}
            episodeNumber={latestEpisode.number}
          />
        )
      }
      <PodcastPlatformPopover
        slot="cta"
        platforms={latestEpisodePlatforms}
        id="home-listen"
        label="Listen elsewhere"
      />
    </FeatureSection>

    <FeatureSection
      id="carroi"
      title={carRoi.name}
      description={carRoi.tagline}
      href={carRoi.href}
      ctaLabel="Join waitlist"
      meta={carRoi.status}
    />

    <SectionRow id="writing">
      <h2 class="text-subheading font-semibold text-ink dark:text-ink-dark">Any Chair</h2>
      <p class="measure mt-5 text-[1.0625rem] leading-relaxed text-subtle dark:text-subtle-dark">
        Articles exploring business, technology, and the people behind them.
      </p>
      <div class="mt-6">
        <Button href={linkedInNewsletterUrl} variant="outline" external>Subscribe on LinkedIn</Button>
      </div>
      <div class="mt-8">
        {
          articles.map((article) => (
            <ArticleRow title={article.data.title} summary={article.data.summary} date={article.data.date} href={article.data.href} />
          ))
        }
      </div>
      <div class="mt-6">
        <Button href="/writing/" variant="link">Read all writing</Button>
      </div>
    </SectionRow>

    <SectionRow id="archive">
      <h2 class="text-[15px] font-semibold text-ink dark:text-ink-dark">{legacyBlog.title}</h2>
      <p class="measure mt-2 text-[14px] leading-relaxed text-subtle dark:text-subtle-dark">
        {legacyBlog.description}
      </p>
      <div class="mt-4">
        <a
          href={legacyBlog.href}
          target="_blank"
          rel="noreferrer noopener"
          class="link-underline group inline-flex items-center gap-1.5 text-[13px] font-medium text-subtle transition-colors duration-fast dark:text-subtle-dark dark:hover:text-ink-dark hover:text-ink"
        >
          {legacyBlog.ctaLabel}
          <Icon
            name="arrow-right"
            class="h-3 w-3 transition-transform duration-fast ease-standard group-hover:translate-x-1"
          />
        </a>
      </div>
    </SectionRow>

    <SectionRow id="connect" class="pb-4">
      <Connect />
    </SectionRow>
  </div>
</BaseLayout>
