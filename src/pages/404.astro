---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found">
  <section class="flex min-h-[70vh] items-center px-6 py-24">
    <div class="reveal mx-auto max-w-xl text-center">
      <p class="text-[13px] font-medium tracking-[0.06em] text-subtle uppercase dark:text-subtle-dark">404</p>
      <h1 class="text-balance text-heading mt-3 font-semibold text-ink dark:text-ink-dark">
        This page doesn't exist.
      </h1>
      <p class="mt-4 text-[1.0625rem] leading-relaxed text-subtle dark:text-subtle-dark">
        The link might be broken, or the page may have moved.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-6">
        <Button href="/" variant="filled">Go home</Button>
        <Button href="/#connect" variant="link">Get in touch</Button>
      </div>
    </div>
  </section>
</BaseLayout>
